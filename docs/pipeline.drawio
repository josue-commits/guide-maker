    <mxCell id="m6" parent="laneM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8033F4;strokeColor=#1A1A1C;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="Uploads the post graphic&lt;br&gt;to the Graphic property" vertex="1">
