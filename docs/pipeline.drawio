    <mxCell id="u21" edge="1" parent="1" source="k3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#8C8C8C;dashed=1;endArrow=open;fontSize=9;" target="c7">
