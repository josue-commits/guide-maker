    <mxCell id="s0" parent="laneS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8033F4;strokeWidth=2;fontColor=#1A1A1C;fontSize=9;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;PHASE 0  Topic research&lt;/b&gt;&lt;br&gt;Three sources, correlated.&lt;br&gt;YouTube in two tracks (tool / business), scored apart.&lt;br&gt;X ranked on bookmark rate, never views.&lt;br&gt;Tweet text is a lead, not a source.&lt;br&gt;&lt;b&gt;Scan-health block first:&lt;/b&gt; a dead source is a failure, not a web-search fallback.&lt;br&gt;Returns 3 topics with every resource." vertex="1">
      <mxGeometry height="165" width="175" x="160" y="20" as="geometry" />
    </mxCell>
    <mxCell id="s0b" parent="laneS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8033F4;strokeWidth=2;fontColor=#1A1A1C;fontSize=9;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;Filters (config)&lt;/b&gt;&lt;br&gt;· excluded_topics (competitors, banned subjects)&lt;br&gt;· already shipped: guide DB titles + board keywords&lt;br&gt;· depth gate: official docs + 3 sources + long-form source + 4-7 subpages&lt;br&gt;· hard reject: news, drama, single-feature drop, opinion&lt;br&gt;&lt;b&gt;Output: 3 topics&lt;/b&gt;" vertex="1">
      <mxGeometry height="165" width="175" x="360" y="20" as="geometry" />
    </mxCell>
    <mxCell id="s05" parent="laneS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8033F4;strokeWidth=2;fontColor=#1A1A1C;fontSize=9;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;PHASE 0.5  Calibration read&lt;/b&gt;&lt;br&gt;· top-performers.md (your slot)&lt;br&gt;· CTA bar rules&lt;br&gt;· voice.md + real-post examples&lt;br&gt;· strategy file: advisory, never authoritative" vertex="1">
      <mxGeometry height="165" width="175" x="560" y="20" as="geometry" />
    </mxCell>
    <mxCell id="s1" parent="laneS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8033F4;strokeWidth=2;fontColor=#1A1A1C;fontSize=9;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;PHASE 1  Research + outline&lt;/b&gt;&lt;br&gt;Transcript, guide type (4), verify EVERY URL and price against a first-party page.&lt;br&gt;Gap analysis vs existing guides (stays internal).&lt;br&gt;Returns title, keyword (derived from the guide name, one word), outline, tagged sources." vertex="1">
      <mxGeometry height="165" width="175" x="760" y="20" as="geometry" />
    </mxCell>
    <mxCell id="s2" parent="laneS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8033F4;strokeWidth=2;fontColor=#1A1A1C;fontSize=9;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;PHASE 2  Writes everything&lt;/b&gt;&lt;br&gt;N subpages, 3 copy variations per account (contrarian / problem / quantity hooks), DM templates per destination.&lt;br&gt;Copy never names the keyword, ends on one value line + 👇.&lt;br&gt;180-250 words (config). Runs lint until clean." vertex="1">
      <mxGeometry height="165" width="175" x="1360" y="20" as="geometry" />
    </mxCell>
    <mxCell id="shum" parent="laneS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A1A1C;strokeColor=#1A1A1C;fontColor=#A6CB17;fontSize=11;fontStyle=1;" value="HUMANIZER ALWAYS ON  ·  zero em dashes  ·  zero AI vocabulary  ·  zero engagement instruction in the copy  ·  no cross-guide references  ·  institutional sources cited, creator videos never" vertex="1">
